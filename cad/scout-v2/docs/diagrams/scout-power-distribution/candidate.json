    {
      "dot": "rose",
      "title": "Protection",
      "items": [
        "7.5 A ATM fuse: carries 2.4 A continuous and <1 s 7.7 A bursts; blows on a pack short (≫20 A)",
        "MDD3A: OCP / UVLO / thermal + firmware duty cap (V_cap/V_batt = 8.4 V)",
        "D36V50F5: reverse-input, OCP, thermal, soft start; PG pin → ESP32",
        "Pi GPIO 5 V bypasses input protection: keyed plug, polarity check, no hot-plug"
      ]
    },
    {
      "dot": "amber",
      "title": "Battery cutoffs (ESP32 ADC1)",
      "items": [
        "Warn 10.5 V · motors stop 10.2 V · Pi shutdown 9.9 V · floor 9.0 V",
        "2 s average, ignore dips <0.5 s, 0.3 V hysteresis",
        "Divider calibrated against the multimeter (REQ-SCOUT-013)"
      ]
    },
    {
      "dot": "cyan",
      "title": "Wire and connectors",
      "items": [
        "Battery → fuse → switch → split: 18 AWG silicone, XT30",
        "MDD3A VM 20 AWG (screw terminal); motors 22–24 AWG",
        "Buck → Pi: 20 AWG pair ≤15 cm (0.03 V drop at peak); signals 26–28 AWG"
      ]
    },
