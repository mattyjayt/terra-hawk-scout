  "cards": [
    {
      "dot": "cyan",
      "title": "Odometry without wheel encoders",
      "items": [
        "rf2o matches consecutive scans → forward speed and yaw rate",
        "covariance_relay adds fixed covariance and drops jumps > 0.6 m/s or > 3 rad/s",
        "the EKF fuses that velocity with the MPU-6050 gyro (vyaw only) and owns odom → base_link"
      ]
    },
    {
      "dot": "rose",
      "title": "Safety layers",
      "items": [
        "safety_stop: obstacle < 0.15 m in a ±30° sector, or no scan for 0.3 s → cmd_vel zeroed",
        "base_bridge: no cmd_vel for 0.25 s → S (stop)",
        "R4 watchdog: no M line for 300 ms → motors off"
      ]
    },
    {
      "dot": "violet",
      "title": "Also running (not drawn)",
      "items": [
        "perception: camera_ros → person_detector (YOLO26n · NCNN, ~19 FPS) → pan_tracker → pan/cmd",
        "robot_state_publisher: URDF → tf; slam_toolbox reads /scan and publishes map → odom",
        "foxglove_bridge streams every topic, incl. /scan, /map and /odometry/filtered"
      ]
    },
    {
      "dot": "slate",
      "title": "Next (M3–M4, planned)",
      "items": [
        "Nav2 on the saved map: AMCL, Regulated Pure Pursuit, velocity smoother, collision monitor",
        "mission node: home → pickup → tower → home"
      ]
    }
  ]
