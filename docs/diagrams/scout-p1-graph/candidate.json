  "cards": [
    {
      "dot": "cyan",
      "title": "Topics from base_bridge (P1)",
      "items": [
        "imu/data_raw \u00b7 sensor_msgs/Imu \u00b7 20 Hz (v1) \u00b7 SENSOR QoS",
        "battery \u00b7 sensor_msgs/BatteryState \u00b7 1 Hz",
        "diagnostics \u00b7 diagnostic_msgs/DiagnosticArray \u00b7 1 Hz",
        "joint_states \u00b7 sensor_msgs/JointState \u00b7 20 Hz (pan_joint)",
        "base/debug/yaw \u00b7 std_msgs/Float64 \u00b7 20 Hz (removed in serial v2)"
      ]
    },
    {
      "dot": "violet",
      "title": "P2 perception loop",
      "items": [
        "camera_ros \u2192 person_detector \u2192 pan_tracker \u2192 pan/cmd \u2192 base_bridge \u2192 servo (V)",
        "detections also go to Foxglove; empty array = nobody there",
        "pan/cmd: rad, clamped \u00b1\u03c0/2, servo command only on \u2265 1\u00b0 change, \u2264 20 Hz"
      ]
    },
    {
      "dot": "rose",
      "title": "Safety layers",
      "items": [
        "bridge: no cmd_vel for cmd_timeout 0.25 s \u2192 S once",
        "R4 watchdog: no M line for 300 ms \u2192 motors off, W stop",
        "shutdown: S, then close the port"
      ]
    },
    {
      "dot": "slate",
      "title": "Foxglove",
      "items": [
        "foxglove_bridge subscribes to all topics above, incl. camera/image_raw/compressed",
        "Foxglove Teleop panel publishes cmd_vel through foxglove_bridge"
      ]
    }
  ]
