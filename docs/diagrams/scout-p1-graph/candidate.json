  "cards": [
    {
      "dot": "cyan",
      "title": "Topics from base_bridge (P1)",
      "items": [
        "imu/data_raw · sensor_msgs/Imu · 20 Hz (v1) · SENSOR QoS",
        "battery · sensor_msgs/BatteryState · 1 Hz",
        "diagnostics · diagnostic_msgs/DiagnosticArray · 1 Hz",
        "joint_states · sensor_msgs/JointState · 20 Hz (pan_joint)",
        "base/debug/yaw · std_msgs/Float64 · 20 Hz (removed in serial v2)"
      ]
    },
    {
      "dot": "violet",
      "title": "P2 perception loop",
      "items": [
        "camera_ros → person_detector → pan_tracker → pan/cmd → base_bridge → servo (V)",
        "detections also go to Foxglove; empty array = nobody there",
        "pan/cmd: rad, clamped ±π/2, servo command only on ≥ 1° change, ≤ 20 Hz"
      ]
    },
    {
      "dot": "rose",
      "title": "Safety layers",
      "items": [
        "bridge: no cmd_vel for cmd_timeout 0.25 s → S once",
        "R4 watchdog: no M line for 300 ms → motors off, W stop",
        "shutdown: S, then close the port"
      ]
    },
    {
      "dot": "slate",
      "title": "Foxglove",
      "items": [
        "foxglove_bridge subscribes to all topics above, incl. camera/image_raw/compressed",
        "Foxglove Teleop panel publishes cmd_vel through foxglove_bridge"
      ]
    }
  ]
}